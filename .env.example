MONGODB_URI=
OPENAI_API_KEY=
GEMINI_API_KEY=
REDIS_URL=

NAUKRI_EMAIL=
NAUKRI_PASSWORD=

WELLFOUND_EMAIL=
WELLFOUND_PASSWORD=
WELLFOUND_PHONE=
WELLFOUND_LOCATION=Bengaluru, Karnataka, India
WELLFOUND_LINKEDIN=https://www.linkedin.com/in/your-profile
WELLFOUND_GITHUB=https://github.com/your-username

LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# ── LLM ───────────────────────────────────────────────────────────────────────
# Two OpenAI keys can be configured; pick the live one from the dashboard
# (Status tab). Key 2 is optional — it exists so a key that gets rate-limited
# or rotated mid-run can be swapped without a deploy.
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENAI_ACTIVE_KEY=1
OPENAI_MODEL=gpt-4o-mini
# Do NOT pin an old Gemini model here. 'gemini-2.0-flash' and 'gemini-1.5-flash'
# are both retired and 404, which silently disables Gemini as a fallback.
GEMINI_MODEL=gemini-flash-latest
LLM_PROVIDER_ORDER=openai,gemini

# ── Volume tuning (all optional — code defaults shown) ────────────────────────
# Company-portal apply. Concurrency auto-sizes from the host's core count as
# (cores-1)*2 capped at 16; set this only to override that.
# PORTAL_APPLY_CONCURRENCY=
PORTAL_DISCOVER_CONCURRENCY=12
# Role matching. Broad mode is on by default. Seniority is filtered by default;
# PORTAL_INCLUDE_SENIOR=true roughly doubles matched postings (6.9% -> 13.7% of
# titles) at the cost of applying to roles well above the profile's experience.
PORTAL_BROAD_ROLES=true
PORTAL_INCLUDE_SENIOR=false

# ATS board directory sync (/api/ats-boards/sync).
BOARD_PROBE_LIMIT=3000
PROBE_CONCURRENCY_GREENHOUSE=30
PROBE_CONCURRENCY_LEVER=20
PROBE_CONCURRENCY_ASHBY=5
# ATS_DIRECTORY_BASE=

# ATS detection sweep over tracked companies.
ATS_SWEEP_LIMIT=1200
ATS_SWEEP_CONCURRENCY=10

# Naukri. Its server-side cap is 50 applications/day per account regardless of
# these; they only control how much of that cap actually gets used.
NAUKRI_QUEUE_SIZE=300
NAUKRI_MAX_JOB_AGE_DAYS=30
NAUKRI_JOB_AGE_DAYS=15
